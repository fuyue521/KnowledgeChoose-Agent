# 知选商城智能客服环境变量模板
# 使用方式：
#   Copy-Item .env.example .env
# 然后只在 .env 中填写真实配置。
# .env 已被 .gitignore 排除，禁止把真实密钥提交到 Git。

# ===== LLM =====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ===== Embedding =====
# debug 可以离线运行，但检索效果弱，仅建议开发和测试使用。
EMBEDDING_PROVIDER=debug
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=20

# 如果使用 Ollama，可改为：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text

# ===== RAG 切片与检索 =====
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_VECTOR_TOP_K=8
RAG_BM25_TOP_K=8
RAG_FINAL_TOP_K=5

# ===== 问答模式 =====
# 可选：agent / chain
DEFAULT_MODE=agent

